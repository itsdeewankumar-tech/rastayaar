# RastaYaar's interactive route-stop map uses Leaflet + OpenStreetMap.
# No Google Maps API key is required for the embedded route-stop map.

# Optional: display Google Maps public-transit directions inside the no-match fallback.
# Create a key in Google Maps Platform, enable Maps Embed API, and restrict the key to your site.
# VITE_GOOGLE_MAPS_EMBED_API_KEY=your_google_maps_embed_api_key

# Production URL for generating an absolute XML sitemap.
# Set this to your real deployed domain before running npm run seo:sitemap.
# SITE_URL=https://your-real-domain.com
